# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Supabase (local: los muestra `supabase start`; remoto: Configuración del proyecto > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta las políticas de acceso: no exponer jamás al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública del sitio (enlaces de correos de confirmación y recuperación)
NEXT_PUBLIC_URL_SITIO=http://localhost:3000

# Pagos: en desarrollo solo existe la pasarela simulada (Fase 6 agrega la definitiva)
PAGOS_PROVEEDOR=simulado
PAGOS_SECRETO_SIMULADO=cambiar-por-un-texto-largo-y-aleatorio

# Videos de presentación de cursos: id de la biblioteca PÚBLICA de Bunny Stream (no la de lecciones)
NEXT_PUBLIC_BUNNY_BIBLIOTECA_PUBLICA=

# Videos de lecciones: biblioteca PRIVADA de Bunny Stream con token authentication activado.
# Sin estas dos, el campus muestra "video pendiente". La clave es secreta: nunca con NEXT_PUBLIC_.
BUNNY_BIBLIOTECA_PRIVADA=
BUNNY_CLAVE_TOKEN=

# Texto aleatorio para el hash de IP del formulario de contacto (nunca se guarda la IP)
CONTACTO_SAL=cambiar-por-otro-texto-aleatorio
