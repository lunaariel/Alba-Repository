# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.
# Comprobar la configuración sin mostrar valores: npm run configuracion  (o: npm run configuracion -- .env.local)
# Guía completa por entorno: docs/infraestructura.md

# Entorno: desarrollo (local), pruebas (CI o copia efímera) o produccion (el sitio real).
# En produccion el servidor no arranca con simuladores, http, direcciones locales ni secretos de ejemplo.
APP_ENTORNO=desarrollo

# Supabase (local: los muestra `supabase start`; remoto: Configuración del proyecto > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta las políticas de acceso: no exponer jamás al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública del sitio (enlaces de correos de confirmación y recuperación)
NEXT_PUBLIC_URL_SITIO=http://localhost:3000

# Tareas programadas (/api/procesos): clave larga y aleatoria (mínimo 24 caracteres).
PROCESOS_CLAVE=

# Correo transaccional: hoy solo existe el simulado (registra «simulado», nunca «enviado»). Proveedor real pendiente.
CORREO_PROVEEDOR=simulado

# Pagos: en desarrollo solo existe la pasarela simulada (Fase 6 agrega la definitiva)
PAGOS_PROVEEDOR=simulado
PAGOS_SECRETO_SIMULADO=cambiar-por-un-texto-largo-y-aleatorio

# Videos de presentación de cursos: id de la biblioteca PÚBLICA de Bunny Stream (no la de lecciones)
NEXT_PUBLIC_BUNNY_BIBLIOTECA_PUBLICA=

# Videos de lecciones: biblioteca PRIVADA de Bunny Stream con token authentication activado.
# Sin estas dos, el campus muestra "video pendiente". La clave es secreta: nunca con NEXT_PUBLIC_.
BUNNY_BIBLIOTECA_PRIVADA=
BUNNY_CLAVE_TOKEN=
# Proveedor de video: bunny | simulado | ninguno. «simulado» solo fuera de producción: reproductor de prueba con
# enlace firmado y vencimiento, firmado con VIDEO_SIMULADO_SECRETO (mínimo 16 caracteres).
VIDEO_PROVEEDOR=
VIDEO_SIMULADO_SECRETO=

# Política de seguridad de contenidos: aplicar (predeterminado) u observacion (primer despliegue).
CSP_MODO=

# Texto aleatorio para el hash de IP del formulario de contacto (nunca se guarda la IP)
CONTACTO_SAL=cambiar-por-otro-texto-aleatorio
